# Copy to .env.local and fill in. Never commit .env.local.
# Gemini (document reading): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the Gemini model
GEMINI_MODEL=
# Tiger Data Postgres (Circle, Group Split): connection string from your Tiger Data service
DATABASE_URL=
# Stripe test mode (Apple Pay in Group Split): dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
