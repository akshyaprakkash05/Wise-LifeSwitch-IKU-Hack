# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# ElevenLabs (Listen button). Create a key in ElevenLabs > Developers > API keys,
# restricted to Text to Speech, with a credit limit.
ELEVENLABS_API_KEY=

# Optional voice overrides (defaults: Sandi for English and other languages, Yazhini for Tamil)
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_TA=

# Tiger Data Postgres for Circle (and Group Split). Paste your service's connection string.
# Tables are created automatically the first time the app uses the database.
DATABASE_URL=
