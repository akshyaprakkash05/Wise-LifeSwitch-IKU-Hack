# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# ElevenLabs (Listen button). Create a key in ElevenLabs > Developers > API keys,
# restricted to Text to Speech, with a credit limit.
ELEVENLABS_API_KEY=

# Optional voice overrides (defaults: Sandi for English and other languages, Yazhini for Tamil)
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_TA=

# Gemini reads uploaded documents (Documents tab) and receipt photos (Group Split). Get a key from Google AI Studio.
GEMINI_API_KEY=
# Optional: check current model names in Google AI Studio.
GEMINI_MODEL=gemini-2.5-flash

# Tiger Data Postgres for Circle (and Group Split). Paste your service's connection string.
# Tables are created automatically the first time the app uses the database.
DATABASE_URL=

# Stripe TEST mode for Apple Pay in Group Split (dashboard.stripe.com/test/apikeys). No real money moves.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Your Stripe account's country (Apple Pay needs it). Default GB.
NEXT_PUBLIC_STRIPE_COUNTRY=
